<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!--
      Area do visor. O tamanho muda com o formato escolhido (Full, 3:4, 9:16,
      1:1); o codigo ajusta as restricoes. A foto sai recortada exatamente
      como aparece aqui.
    -->
    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.davidespec.foto.GridOverlay
            android:id="@+id/grid"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone" />

        <View
            android:id="@+id/flashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/white" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="#99000000"
            android:shadowRadius="12"
            android:textColor="@color/white"
            android:textSize="120sp"
            android:visibility="gone" />
    </FrameLayout>

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0"
        android:background="@drawable/focus_ring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/TopIcon"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/flashButton"
            style="@style/TopIcon"
            android:contentDescription="@string/flash"
            android:src="@drawable/ic_flash_off" />

        <ImageButton
            android:id="@+id/timerButton"
            style="@style/TopIcon"
            android:contentDescription="@string/timer"
            android:src="@drawable/ic_timer" />

        <TextView
            android:id="@+id/aspectButton"
            style="@style/TopText"
            android:contentDescription="@string/aspect"
            android:text="Full" />

        <TextView
            android:id="@+id/resolutionButton"
            style="@style/TopText"
            android:contentDescription="@string/resolution"
            android:text="12M" />

        <ImageButton
            android:id="@+id/gridButton"
            style="@style/TopIcon"
            android:contentDescription="@string/grid"
            android:src="@drawable/ic_layers" />
    </LinearLayout>

    <!-- Tempo de gravacao do video -->
    <LinearLayout
        android:id="@+id/recBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topBar">

        <View
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/rec_dot" />

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Parte de baixo: zoom, modos e disparador -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/modeBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="40dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modePortrait"
                style="@style/ModeText"
                android:text="RETRATO" />

            <TextView
                android:id="@+id/modePhoto"
                style="@style/ModeText"
                android:text="FOTO" />

            <TextView
                android:id="@+id/modeVideo"
                style="@style/ModeText"
                android:text="VÍDEO" />

            <TextView
                android:id="@+id/modeMore"
                style="@style/ModeText"
                android:text="MAIS" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="40dp">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/thumb_frame"
                android:contentDescription="@string/open_last"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <ImageButton
                android:id="@+id/shutter"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter"
                android:contentDescription="@string/take_photo" />

            <ImageButton
                android:id="@+id/switchButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/switch_camera"
                android:scaleType="center"
                android:src="@drawable/ic_switch"
                app:tint="@color/white" />
        </FrameLayout>
    </LinearLayout>

    <!-- Sem permissao da camera -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_text"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/permission_button" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
