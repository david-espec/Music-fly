<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black">

    <!--
      Area do visor. O tamanho muda com o formato escolhido (Full, 3:4, 9:16,
      1:1); o codigo ajusta as restricoes. A foto sai recortada exatamente
      como aparece aqui.
    -->
    <FrameLayout
        android:id="@+id/previewBox"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.camera.view.PreviewView
            android:id="@+id/preview"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <com.davidespec.foto.CameraOverlay
            android:id="@+id/overlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

        <View
            android:id="@+id/flashOverlay"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:alpha="0"
            android:background="@color/white" />

        <TextView
            android:id="@+id/countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:shadowColor="#99000000"
            android:shadowRadius="12"
            android:textColor="@color/white"
            android:textSize="120sp"
            android:visibility="gone" />

        <!-- Guia do panorama -->
        <LinearLayout
            android:id="@+id/panoramaGuide"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginHorizontal="32dp"
            android:background="@drawable/panel_bg"
            android:gravity="center"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/panoramaText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="15sp" />

            <ProgressBar
                android:id="@+id/panoramaProgress"
                style="@android:style/Widget.Material.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:max="1000"
                android:progressTint="@color/accent" />
        </LinearLayout>
    </FrameLayout>

    <View
        android:id="@+id/focusRing"
        android:layout_width="72dp"
        android:layout_height="72dp"
        android:alpha="0"
        android:background="@drawable/focus_ring"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Barra superior -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="8dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/settingsButton"
            style="@style/TopIcon"
            android:contentDescription="@string/settings"
            android:src="@drawable/ic_settings" />

        <ImageButton
            android:id="@+id/flashButton"
            style="@style/TopIcon"
            android:contentDescription="@string/flash"
            android:src="@drawable/ic_flash_off" />

        <TextView
            android:id="@+id/hdrButton"
            style="@style/TopText"
            android:contentDescription="HDR"
            android:text="HDR" />

        <ImageButton
            android:id="@+id/timerButton"
            style="@style/TopIcon"
            android:contentDescription="@string/timer"
            android:src="@drawable/ic_timer" />

        <ImageButton
            android:id="@+id/micButton"
            style="@style/TopIcon"
            android:contentDescription="Microfone"
            android:src="@drawable/ic_mic"
            android:visibility="gone" />

        <TextView
            android:id="@+id/fpsButton"
            style="@style/TopText"
            android:contentDescription="Quadros por segundo"
            android:text="30"
            android:visibility="gone" />

        <TextView
            android:id="@+id/aspectButton"
            style="@style/TopText"
            android:contentDescription="@string/aspect"
            android:text="3:4" />

        <TextView
            android:id="@+id/resolutionButton"
            style="@style/TopText"
            android:contentDescription="@string/resolution"
            android:text="12M" />

        <ImageButton
            android:id="@+id/effectsButton"
            style="@style/TopIcon"
            android:contentDescription="Filtros e efeitos"
            android:src="@drawable/ic_layers" />
    </LinearLayout>

    <!-- Tempo de gravacao do video -->
    <LinearLayout
        android:id="@+id/recBox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/pill_dark"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/topBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/topBar">

        <View
            android:id="@+id/recDot"
            android:layout_width="8dp"
            android:layout_height="8dp"
            android:background="@drawable/rec_dot" />

        <TextView
            android:id="@+id/recTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:fontFeatureSettings="tnum"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Avisos: trava AE/AF, modo, dicas -->
    <TextView
        android:id="@+id/infoLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="24dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/pill_dark"
        android:gravity="center"
        android:paddingHorizontal="14dp"
        android:paddingVertical="6dp"
        android:textColor="@color/white"
        android:textSize="13sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <com.davidespec.foto.HistogramView
        android:id="@+id/histogram"
        android:layout_width="96dp"
        android:layout_height="52dp"
        android:layout_marginStart="16dp"
        android:layout_marginTop="44dp"
        android:visibility="gone"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/topBar" />

    <!-- QR Code encontrado -->
    <TextView
        android:id="@+id/qrChip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="32dp"
        android:layout_marginBottom="12dp"
        android:background="@drawable/pill_dark"
        android:drawablePadding="8dp"
        android:ellipsize="middle"
        android:maxWidth="320dp"
        android:paddingHorizontal="16dp"
        android:paddingVertical="10dp"
        android:singleLine="true"
        android:textColor="@color/accent"
        android:textSize="14sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintBottom_toTopOf="@id/bottomPanel"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Parte de baixo: exposicao, painel de efeitos, zoom, modos e disparador -->
    <LinearLayout
        android:id="@+id/bottomPanel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:paddingBottom="36dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <!-- Painel de efeitos / Pro, montado pelo codigo -->
        <LinearLayout
            android:id="@+id/panel"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="12dp"
            android:layout_marginBottom="8dp"
            android:background="@drawable/panel_bg"
            android:orientation="vertical"
            android:padding="10dp"
            android:visibility="gone" />

        <!-- Exposicao (EV) depois de tocar para focar -->
        <LinearLayout
            android:id="@+id/evBar"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:contentDescription="Exposição"
                android:src="@drawable/ic_sun"
                app:tint="@color/accent" />

            <SeekBar
                android:id="@+id/evSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:progressTint="@color/accent"
                android:thumbTint="@color/accent" />

            <TextView
                android:id="@+id/evValue"
                android:layout_width="44dp"
                android:layout_height="wrap_content"
                android:gravity="end"
                android:text="0.0"
                android:textColor="@color/accent"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Zoom continuo, aparece ao pincar ou tocar no zoom ativo -->
        <LinearLayout
            android:id="@+id/zoomSliderBox"
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:layout_marginHorizontal="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <SeekBar
                android:id="@+id/zoomSeek"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:max="1000"
                android:progressTint="@color/white"
                android:thumbTint="@color/white" />

            <TextView
                android:id="@+id/zoomValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minWidth="64dp"
                android:gravity="end"
                android:textColor="@color/white"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/zoomBar"
            android:layout_width="wrap_content"
            android:layout_height="48dp"
            android:gravity="center"
            android:orientation="horizontal" />

        <LinearLayout
            android:id="@+id/modeBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/modePortrait"
                style="@style/ModeText"
                android:text="RETRATO" />

            <TextView
                android:id="@+id/modePhoto"
                style="@style/ModeText"
                android:text="FOTO" />

            <TextView
                android:id="@+id/modeVideo"
                style="@style/ModeText"
                android:text="VÍDEO" />

            <TextView
                android:id="@+id/modeMore"
                style="@style/ModeText"
                android:text="MAIS" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:paddingHorizontal="40dp">

            <ImageView
                android:id="@+id/thumbnail"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/thumb_frame"
                android:contentDescription="@string/open_last"
                android:padding="2dp"
                android:scaleType="centerCrop" />

            <ImageButton
                android:id="@+id/pauseButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="start|center_vertical"
                android:layout_marginStart="8dp"
                android:background="@drawable/zoom_chip"
                android:contentDescription="Pausar gravação"
                android:scaleType="center"
                android:src="@drawable/ic_pause"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/shutter"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:background="@drawable/shutter"
                android:contentDescription="@string/take_photo" />

            <TextView
                android:id="@+id/shutterLabel"
                android:layout_width="92dp"
                android:layout_height="92dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:textColor="#FF111111"
                android:textSize="22sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <ProgressBar
                android:id="@+id/busySpinner"
                android:layout_width="96dp"
                android:layout_height="96dp"
                android:layout_gravity="center"
                android:indeterminateTint="@color/accent"
                android:visibility="gone" />

            <ImageButton
                android:id="@+id/switchButton"
                android:layout_width="64dp"
                android:layout_height="64dp"
                android:layout_gravity="end|center_vertical"
                android:layout_marginEnd="8dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/switch_camera"
                android:scaleType="center"
                android:src="@drawable/ic_switch"
                app:tint="@color/white" />

            <ImageButton
                android:id="@+id/snapshotButton"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_gravity="end|top"
                android:layout_marginTop="-64dp"
                android:layout_marginEnd="12dp"
                android:background="@drawable/zoom_chip"
                android:contentDescription="Foto durante o vídeo"
                android:scaleType="center"
                android:src="@drawable/ic_snapshot"
                android:visibility="gone" />
        </FrameLayout>
    </LinearLayout>

    <!-- Flash de tela para a camera frontal -->
    <View
        android:id="@+id/screenFlash"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#FFFFF4E0"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Sem permissao da camera -->
    <LinearLayout
        android:id="@+id/permissionPanel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/black"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="32dp"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/permission_text"
            android:textColor="@color/white"
            android:textSize="16sp" />

        <Button
            android:id="@+id/permissionButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:text="@string/permission_button" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
